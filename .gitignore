# Editors and operating systems
.vscode/
.idea/
*.iml
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Local environment variables and secrets; retain the public template
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.p12
*.pfx

# Logs and generated package/build artifacts
logs/
*.log
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Local databases and sidecars
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Local research data, uploads, models, reports, and experiment outputs
/data/*
!/data/.gitkeep
/datasets/*
!/datasets/.gitkeep
/uploads/*
!/uploads/.gitkeep
/artifacts/*
!/artifacts/.gitkeep
/outputs/*
!/outputs/.gitkeep
/models/*
!/models/.gitkeep
/mlruns/
/wandb/

# Temporary files
/tmp/
/temp/
*.tmp
*.temp
*.bak
*~
