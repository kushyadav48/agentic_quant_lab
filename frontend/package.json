{
  "name": "quantlab-dashboard", "version": "0.1.0", "private": true, "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1", "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1", "test": "vitest run",
    "contracts": "openapi-typescript contracts/openapi.json -o src/api/generated.ts",
    "contracts:check": "node scripts/check-contracts.mjs",
    "measure": "node scripts/measure-ui.mjs"
  },
  "dependencies": { "react": "^19.2.0", "react-dom": "^19.2.0", "lightweight-charts": "^5.0.0" },
  "overrides": { "rollup": "npm:@rollup/wasm-node@4.64.3" },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.0", "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0", "@types/node": "^22.19.0",
    "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.0.0", "openapi-typescript": "^7.10.0", "typescript": "^5.9.0",
    "vite": "^7.2.0", "vitest": "4.1.11"
  }
}
