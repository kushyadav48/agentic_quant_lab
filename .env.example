# Phase 21 local API environment template. The launcher does not load .env itself.
# Set these in your shell; never commit credentials. Empty operator secret fails closed.
QUANTLAB_API_OPERATOR_TOKEN=
# Optional separate read-only credential; both secrets require 32-256 ASCII characters.
QUANTLAB_API_READER_TOKEN=
QUANTLAB_API_PORT=8000
# Optional verified production Vite build. Empty retains the API-only launcher.
# scripts/start-local.ps1 sets this to the repository's frontend/dist.
QUANTLAB_API_FRONTEND_PATH=
# Optional trusted server path: existing Phase 20 journal, or a new local journal.
# No journal is opened when this is empty. Never accept this value from HTTP input.
QUANTLAB_API_JOURNAL_PATH=
# Optional comma-separated exact loopback origins, e.g. http://localhost:3000.
# No cross-origin access is allowed by default; wildcards and remote origins fail.
QUANTLAB_API_CORS_ORIGINS=

# Phase 23 cloud inference stays disabled; all values are server-side only.
# No model is assumed free. See docs/cloud-llm.md for current verification setup.
QUANTLAB_CLOUD_ENABLED=false
QUANTLAB_CLOUD_PROVIDER=gemini
QUANTLAB_CLOUD_MODEL=
QUANTLAB_CLOUD_MODEL_ALLOWLIST=
QUANTLAB_CLOUD_FREE_VERIFICATION=
QUANTLAB_CLOUD_MAX_REQUESTS=20
QUANTLAB_CLOUD_TIMEOUT_MS=20000
GEMINI_API_KEY=
